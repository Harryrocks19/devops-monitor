# Local development
# DATABASE_URL=postgresql://postgres:root@localhost:5432/devops_monitor

# Docker / Production (use this when running with docker-compose)
DATABASE_URL=postgresql://postgres:root@db:5432/devops_monitor

# Email alert config (optional - leave blank to skip email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
ALERT_TO=receiver_email@gmail.com
